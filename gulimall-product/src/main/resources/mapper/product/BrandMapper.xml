<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gulimall.product.mapper.BrandMapper">

    <resultMap type="com.gulimall.product.domain.Brand" id="BrandResult">
            <result property="brandId" column="brand_id" />
            <result property="name" column="name" />
            <result property="logo" column="logo" />
            <result property="descript" column="descript" />
            <result property="showStatus" column="show_status" />
            <result property="firstLetter" column="first_letter" />
            <result property="sort" column="sort" />
    </resultMap>

    <!-- ============================================================ -->
    <!-- 基础 CRUD 全部由 MyBatis-Plus 的 BaseMapper 提供，无需在此实现 -->
    <!-- 只有自定义的多表查询、复杂统计等才需要在这里编写 SQL            -->
    <!-- ============================================================ -->

</mapper>
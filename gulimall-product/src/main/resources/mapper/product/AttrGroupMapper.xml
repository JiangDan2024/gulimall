<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gulimall.product.mapper.AttrGroupMapper">

    <resultMap id="SpuItemAttrGroupVo" type="com.gulimall.product.vo.SpuItemAttrGroupVo">
        <result property="groupName" column="attr_group_name"></result>
        <collection property="attrs" ofType="com.gulimall.product.vo.Attr">
            <result property="attrName" column="attr_name"></result>
            <result property="attrValue" column="attr_value"></result>
        </collection>
    </resultMap>

    <select id="getAttrGroupWithAttrBySpuId" resultMap="SpuItemAttrGroupVo">
        select
            att.attr_group_id ,
            att.attr_group_name,
            attgroup.attr_id,
            pro.attr_name,
            pro.attr_value
        from
            `pms_attr_group` att
                left join `pms_attr_attrgroup_relation` attgroup on att.attr_group_id = attgroup.attr_group_id
                left join `pms_product_attr_value` pro on attgroup.attr_id  = pro.attr_id
        where att.catelog_id=#{catalogId} and pro.spu_id = #{spuId}
    </select>
</mapper>
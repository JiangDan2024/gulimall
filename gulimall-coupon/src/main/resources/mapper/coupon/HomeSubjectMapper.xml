<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gulimall.coupon.mapper.HomeSubjectMapper">

    <resultMap type="com.gulimall.coupon.domain.HomeSubject" id="HomeSubjectResult">
            <result property="id" column="id" />
            <result property="name" column="name" />
            <result property="title" column="title" />
            <result property="subTitle" column="sub_title" />
            <result property="status" column="status" />
            <result property="url" column="url" />
            <result property="sort" column="sort" />
            <result property="img" column="img" />
    </resultMap>

    <!-- ============================================================ -->
    <!-- 基础 CRUD 全部由 MyBatis-Plus 的 BaseMapper 提供，无需在此实现 -->
    <!-- 只有自定义的多表查询、复杂统计等才需要在这里编写 SQL            -->
    <!-- ============================================================ -->

</mapper>